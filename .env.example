# OPENAI_API_KEY: Required for OpenAI Creative AI and GPT Image 2 reference generation.
# Configure this in the Secrets panel in Google AI Studio or .env file on the server.
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL: Supabase Cloud Backup Layer (Disabled by default if not set)
# If left empty, ZAP Visual Guide continues running 100% offline via IndexedDB/localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


